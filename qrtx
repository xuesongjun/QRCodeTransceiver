#!/usr/bin/csh -f

# 1. 记录当前执行命令的目录
# C Shell 的 $cwd 变量存储当前工作目录。
set ORIGINAL_CWD = $cwd

# 需要提前把qrcode_transceiver目录添加到Linux系统的环境变量中，方便在任何目录下执行qrtx命令。
# 2. 设置项目根目录
set PROJECT_ROOT = "~/local/qrcode_transceiver" 

# 3. 切换到项目目录（为了激活 venv）
cd $PROJECT_ROOT

# 定义 prompt 变量，避免 activate.csh 报错
if (! $?prompt) set prompt = ""

# 4. 激活虚拟环境
source $PROJECT_ROOT/venv/bin/activate.csh

# --- 关键步骤：切换回原始目录 ---
# 5. 切换回用户执行命令的目录
cd $ORIGINAL_CWD

# 6. 运行 Python 脚本，并传递所有参数 ($argv)
# Python 现在会在 $ORIGINAL_CWD 中查找文件
python $PROJECT_ROOT/qrcode_tx.py $argv

# 7. 可选：停用虚拟环境 
deactivate
