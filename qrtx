#!/usr/bin/csh -f

set SCRIPT_PATH = "$0"
set SCRIPT_DIR = `dirname "$SCRIPT_PATH"`
set SCRIPT_DIR = `cd "$SCRIPT_DIR"; pwd`

if ( $?QRTX_ROOT ) then
    set PROJECT_ROOT = "$QRTX_ROOT"
else
    set PROJECT_ROOT = "$SCRIPT_DIR"
endif

if ( -x "$PROJECT_ROOT/venv/bin/python" ) then
    set PYTHON_BIN = "$PROJECT_ROOT/venv/bin/python"
else if ( $?PYTHON ) then
    set PYTHON_BIN = "$PYTHON"
else
    set PYTHON_BIN = `which python3`
    if ( "$PYTHON_BIN" == "" ) then
        set PYTHON_BIN = `which python`
    endif
    if ( "$PYTHON_BIN" == "" ) then
        echo "Error: python3/python not found in PATH." >&2
        exit 1
    endif
endif

exec "$PYTHON_BIN" "$PROJECT_ROOT/qrcode_tx.py" $argv
